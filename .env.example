# Copy to .env when you need to override a default. Never commit .env.
#
# `make dev` works with no .env at all: development defaults live in
# docker-compose.yml and the API refuses to start in production while the
# development secret is still in place. Every value below is therefore
# optional locally and required on the server.

# --- Database -------------------------------------------------------------
POSTGRES_DB=supervision
POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword

# --- Application ----------------------------------------------------------
# 32+ random bytes in production. Used to sign the session cookie.
APP_SECRET_KEY=dev-only-not-a-secret
APP_BASE_URL=http://localhost:8080
APP_VERSION=0.1.0
APP_ENV=development

# --- Mail (used from the alerting ticket onward) --------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_RECIPIENT=

# --- Offsite backup (used from the deployment ticket onward) --------------
OVH_S3_ENDPOINT=
OVH_S3_BUCKET=
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
RESTIC_PASSWORD=
